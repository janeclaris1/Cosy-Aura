# Database — Neon Postgres (works with Prisma on Hostinger)
# Use the *pooler* host for the app (DATABASE_URL) and the *direct* host for migrations (DIRECT_URL).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Super Admin emails (comma-separated). Only these accounts can manage branches & staff.
# SUPER_ADMIN_EMAILS="you@cosyaura.com"

# Branch stock: alert admins when a size qty is at or below this (default 5)
# LOW_STOCK_THRESHOLD=5

# Transfers at/above this qty need manager approval (default 20). Fulfilment always needs approval.
# TRANSFER_APPROVAL_THRESHOLD=20

# Public site URL (used by robots.txt / sitemap; set to https://cosyaura.com in production)
NEXT_PUBLIC_SITE_URL="https://cosyaura.com"
NEXT_PUBLIC_SITE_NAME="Luxury Perfumes"
NEXT_PUBLIC_SITE_DESCRIPTION="Oil-based perfume oils crafted in Grasse"
# Set to 1 to register the PWA service worker during local `next dev`
# NEXT_PUBLIC_PWA_DEV="1"

# Hero mini video on the landing slider (YouTube by default).
# https://www.youtube.com/watch?v=s0UL1nLCuF0&t=45s
NEXT_PUBLIC_HERO_VIDEO_YOUTUBE="s0UL1nLCuF0"
NEXT_PUBLIC_HERO_VIDEO_START="45"
# Optional: use a local mp4 instead (public/videos/hero.mp4)
# NEXT_PUBLIC_HERO_VIDEO_SRC="/videos/hero.mp4"

# Footer social profiles (optional overrides)
# NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/yourhandle"
# NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/yourpage"
# NEXT_PUBLIC_TWITTER_URL="https://x.com/yourhandle"
# Optional: Gents Scents YouTube channel ID (defaults to @GentsScents)
# GENTS_SCENTS_CHANNEL_ID="UC9IImcLkUdmURWtQhxu8VwQ"

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-SNL8Y1TBSQ"

# Meta (Facebook) Pixel — Events Manager → Data sources → Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=""
# Optional alias (same value); public id is preferred for the browser script
# META_PIXEL_ID=""

# Meta Commerce / Facebook Shop product feed
# Generate a long random string, then add this URL in Commerce Manager → Catalog → Data sources → Data feed:
# https://YOUR_DOMAIN/api/feeds/meta-catalog?token=YOUR_TOKEN
META_CATALOG_FEED_TOKEN=""
# Currency shown in the catalog feed (default GHS)
META_CATALOG_CURRENCY="GHS"

# Google Merchant Center / Google Shopping product feed
# Merchant Center → Products → Feeds → Scheduled fetch:
# https://YOUR_DOMAIN/api/feeds/google-shopping?token=YOUR_TOKEN
GOOGLE_SHOPPING_FEED_TOKEN=""
GOOGLE_SHOPPING_CURRENCY="GHS"
# Google shipping attribute: country:region:service:price
GOOGLE_SHOPPING_SHIPPING="GH:::0.00 GHS"

# Default non-Africa USD surcharge (admin can override at /admin/pricing)
NON_AFRICA_MARKUP_USD="10"

# Google Business reviews (Places API — server-side only)
# 1. Cloud Console → enable "Places API (New)" and/or "Places API"
# 2. Create an API key restricted to those APIs
# 3. Place ID: https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""

# Set to true to put the storefront in maintenance mode (admin stays available)
MAINTENANCE_MODE="false"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Required for embedded Checkout in the browser (same value as STRIPE_PUBLISHABLE_KEY)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Paystack — Ghana & Nigeria checkout only
PAYSTACK_SECRET_KEY="sk_test_..."
# Optional second account if Nigeria settles in NGN
# PAYSTACK_SECRET_KEY_NG="sk_test_..."
# Optional FX fallbacks when live rates are unavailable (1 GHS → local)
# GHS_TO_NGN="160"
# Dashboard → Settings → API Keys & Webhooks → https://YOUR_DOMAIN/api/webhooks/paystack

# Flutterwave — CEMAC (Cameroon, Gabon, Congo, Chad, Equatorial Guinea, CAR)
FLW_SECRET_KEY="FLWSECK_TEST-..."
# Secret hash from Flutterwave dashboard → Settings → Webhooks
FLW_SECRET_HASH=""
# GHS_TO_XAF="42"
# Webhook URL: https://YOUR_DOMAIN/api/webhooks/flutterwave

# Dawurobo — Ghana next-day delivery (https://docs.dawurobo.com/docs/getting-started)
# Staging and production use the same base URL; the key environment decides.
DAWUROBO_API_KEY="pk_staging_..."
DAWUROBO_SIGNING_SECRET="sk_..."
DAWUROBO_WEBHOOK_SECRET=""
# Optional public webhook URL override per order
# DAWUROBO_WEBHOOK_URL="https://YOUR_DOMAIN/api/webhooks/dawurobo"
# Warehouse / pickup (required for estimates + booking)
DAWUROBO_PICKUP_LAT="5.58"
DAWUROBO_PICKUP_LNG="-0.22"
DAWUROBO_PICKUP_ADDRESS="Your shop street, Accra"
DAWUROBO_PICKUP_CITY="Accra"
DAWUROBO_PICKUP_REGION="Greater Accra"
DAWUROBO_PICKUP_CONTACT="COSY AURA"
DAWUROBO_PICKUP_PHONE="0200000000"
# Prepaid delivery (customer pays fee in Paystack) — needs production key + wallet scope
# DAWUROBO_PARTNER_PAYER_ENABLED="true"

# ShaQ Express — nationwide Ghana delivery (outside Greater Accra, or fallback)
# Docs: https://public-api.shaqexpress.com
SHAQEXPRESS_BASE_URL="https://test-partner.shaqexpress.com/api/v1"
SHAQEXPRESS_IDENTIFIER=""
SHAQEXPRESS_SECRET=""
SHAQEXPRESS_SOURCE_ADDRESS="Your shop street, Accra"
# Default flat delivery fee (GHS) — Accra vs rest of Ghana
SHAQEXPRESS_ACCRA_FEE_GHS="63"
SHAQEXPRESS_OUTSIDE_ACCRA_FEE_GHS="84"
# Ghana orders at or above this product subtotal (GHS) ship free
# GHANA_FREE_DELIVERY_THRESHOLD_GHS="1000"
# Optional per-region overrides: {"Ashanti":90,"Northern":95}
# SHAQEXPRESS_DELIVERY_FEES_JSON=""
# Webhook URL: https://YOUR_DOMAIN/api/webhooks/shaqexpress
# SHAQEXPRESS_WEBHOOK_SECRET=""

# EasyPost — live Aramex / DHL / FedEx rates (connect carriers in EasyPost dashboard)
EASYPOST_API_KEY=""
SHIP_FROM_NAME="COSY AURA"
SHIP_FROM_STREET1="1 Market St"
SHIP_FROM_CITY="San Francisco"
SHIP_FROM_STATE="CA"
SHIP_FROM_ZIP="94105"
SHIP_FROM_COUNTRY="US"
SHIP_FROM_PHONE="4155550100"
SHIP_FROM_EMAIL="shipping@cosyaura.com"
# Watch parcel defaults (inches / pounds)
SHIP_PARCEL_LENGTH="8"
SHIP_PARCEL_WIDTH="6"
SHIP_PARCEL_HEIGHT="4"
SHIP_PARCEL_WEIGHT="1.5"

# Algolia
NEXT_PUBLIC_ALGOLIA_APP_ID="your-app-id"
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY="your-search-only-key"
ALGOLIA_ADMIN_KEY="your-admin-key"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Pexels — stock photos for blog / marketing imagery
PEXELS_API_KEY="your-pexels-api-key"

# Support chat agent (optional). Without a key, the widget still answers from store FAQ + catalog.
ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-haiku-4-5"
# When a shopper closes the Enow chat (or leaves the site), a summary is emailed + WhatsApped.
# Defaults to ADMIN_NOTIFICATION_EMAIL and WHATSAPP_NOTIFY_TO.
# SUPPORT_SUMMARY_EMAIL="admin@cosyaura.com"
# SUPPORT_SUMMARY_WHATSAPP="+233500741699"

# Email notifications (Resend) — REQUIRED on production for order emails
# Domain in EMAIL_FROM must be verified in Resend (cosyaura.com is fine once verified)
# Format MUST be: Display Name <email@domain.com>  (space before < is required)
RESEND_API_KEY="re_..."
EMAIL_FROM="COSY AURA <orders@cosyaura.com>"
# Optional: used automatically if EMAIL_FROM domain is not verified in Resend yet
# RESEND_FALLBACK_FROM="COSY AURA <onboarding@resend.dev>"
ADMIN_NOTIFICATION_EMAIL="admin@cosyaura.com"
# Comma-separated for multiple recipients, e.g. "admin@cosyaura.com,sales@cosyaura.com"
# Set true only for local UI testing without sending real mail
# EMAIL_DEV_LOG="true"

# Public header WhatsApp by detected country (digits with country code, no +)
# GH / CM / NG show that number; all other countries show US.
NEXT_PUBLIC_WHATSAPP_GH="233500741699"
NEXT_PUBLIC_WHATSAPP_CM=""
NEXT_PUBLIC_WHATSAPP_NG=""
NEXT_PUBLIC_WHATSAPP_US=""

# WhatsApp — owner alert + customer payment receipt after every paid order
WHATSAPP_NOTIFY_TO="+233500741699"
# Pick ONE provider:
# 1) Twilio WhatsApp (sandbox or live sender)
TWILIO_ACCOUNT_SID="ACxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxx"
# Sandbox sender (join first). Live WhatsApp sender once approved:
# Customer receipts only reach numbers that can receive from this sender.
# Twilio sandbox: each customer must join the sandbox first.
# Use an approved live WhatsApp Business sender for real buyer receipts.
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# 2) Meta WhatsApp Cloud API
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# Optional approved template for business-initiated alerts
# WHATSAPP_TEMPLATE_NAME=""
# WHATSAPP_TEMPLATE_LANG="en"
# 3) CallMeBot (fastest personal alerts — get a key at https://www.callmebot.com/blog/free-api-whatsapp-messages/)
# CALLMEBOT_API_KEY=""

# Dawurobo — Ghana next-day delivery
DAWUROBO_API_KEY="pk_staging_45bbfa8c008cab25a2b5928b9a32a48c292f8031f75fcb91"
DAWUROBO_SIGNING_SECRET="sk_8a6e1cf91ecf04c38209378e7056feb96c7115d6a0b048ba"
DAWUROBO_WEBHOOK_SECRET="whsec_c441ce3ba83006ed4303101d1d89c53b17b604d7e3d0319746891cc61b5658fc"
DAWUROBO_PICKUP_LAT="5.58"
DAWUROBO_PICKUP_LNG="-0.22"
DAWUROBO_PICKUP_ADDRESS="Your shop street, Accra"
DAWUROBO_PICKUP_CITY="Accra"
DAWUROBO_PICKUP_REGION="Greater Accra"
DAWUROBO_PICKUP_CONTACT="COSY AURA"
DAWUROBO_PICKUP_PHONE="0558660863"

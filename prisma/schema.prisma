generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

/** Operational role inside the admin portal (portal access still requires Role.ADMIN). */
enum StaffRole {
  COUNTRY_MANAGER
  BRANCH_MANAGER
  HR
  ACCOUNTANT
  FULFILMENT
  CONTENT
  SUPPORT
}

enum Condition {
  UNWORN
  EXCELLENT
  GOOD
}

enum FragranceFamily {
  FLORAL
  ORIENTAL
  WOODY
  FRESH
  CITRUS
  SPICY
}

enum BottleMaterial {
  GLASS
  CRYSTAL
  METAL
  CERAMIC
  ACRYLIC
}

enum CapType {
  MAGNETIC
  SPRAY
  DAB_ON
  SCREW
}

enum Concentration {
  EDT
  EDP
  PARFUM
  EXTRAIT
}

enum Sillage {
  SUBTLE
  MODERATE
  INTENSE
  POWERFUL
}

enum Gender {
  MENS
  WOMENS
  UNISEX
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderChannel {
  WEB
  POS
}

enum PosPaymentMethod {
  CASH
  MOMO
  CARD
  OTHER
}

enum PosDiscountType {
  PERCENT
  FIXED
}

enum AttendancePunchType {
  CLOCK_IN
  CLOCK_OUT
}

enum AttendanceSource {
  BIOMETRIC
  MANUAL
  WEBHOOK
}

enum StockTransferStatus {
  PENDING
  COMPLETED
  REJECTED
  CANCELLED
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  name           String?
  phone          String?
  password       String?
  role           Role       @default(USER)
  /** Operational admin role; null + ADMIN = legacy full access until assigned. */
  staffRole      StaffRole?
  /** Country scope for COUNTRY_MANAGER (e.g. GH, CM). */
  staffCountry   String?
  activeStaff    Boolean    @default(true)
  /** Permanent 5% member discount for email/account signups */
  memberDiscount Boolean    @default(true)
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  accounts         Account[]
  sessions         Session[]
  orders           Order[]
  wishlist         WishlistItem[]
  reviews          FragranceReview[]
  staffAssignments StaffAssignment[]
  auditLogs        AuditLog[]
  stockTransfers   StockTransfer[]       @relation("TransferCreatedBy")
  transfersApproved StockTransfer[]      @relation("TransferApprovedBy")
  passwordTokens   AdminPasswordToken[]
  posOrders              Order[]                 @relation("PosOrders")
  attendancePunches      AttendancePunch[]
  attendanceEnrollments  AttendanceEnrollment[]
  manualAttendancePunches AttendancePunch[]      @relation("ManualAttendance")
  employeeProfile        EmployeeProfile?
  leaveRequestsReviewed  LeaveRequest[]           @relation("LeaveReviewedBy")
  payRunsCreated         PayRun[]                 @relation("PayRunCreatedBy")
  payRunsApproved        PayRun[]                 @relation("PayRunApprovedBy")
  journalsCreated        JournalEntry[]           @relation("JournalCreatedBy")

  @@index([email])
  @@index([phone])
  @@index([staffRole])
  @@index([staffCountry])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fragrances Fragrance[]
  series     Series[]

  @@index([slug])
}

model Series {
  id        String   @id @default(cuid())
  brandId   String
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand      Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  fragrances Fragrance[]

  @@unique([brandId, slug])
  @@index([brandId])
  @@index([slug])
}

model Fragrance {
  id                  String           @id @default(cuid())
  slug                String           @unique
  brandId             String
  seriesId            String?
  model               String
  reference           String
  description         String           @db.Text
  conditionReport     String?          @db.Text
  price               Float
  /** Unit cost in GHS for catalog bottleSize (used for COGS). */
  costPriceGhs        Float               @default(0)
  condition           Condition
  year                Int?
  fragranceFamily     FragranceFamily
  bottleMaterial      BottleMaterial
  bottleDetail        String?
  bottleSize          Int              @default(100)
  capType             CapType
  liquidColor         String?
  longevity           String?
  bottleShape         String?
  concentration       Concentration    @default(EDP)
  topNotes            String[]         @default([])
  heartNotes          String[]         @default([])
  baseNotes           String[]         @default([])
  sillage             Sillage          @default(MODERATE)
  sustainabilityScore Int              @default(3)
  isVegan             Boolean          @default(false)
  isCrueltyFree       Boolean          @default(true)
  sampleAvailable     Boolean          @default(false)
  gender              Gender           @default(UNISEX)
  collection          String?
  stock               Int              @default(0)
  rating              Float?
  viewCount           Int              @default(0)
  likeCount           Int              @default(0)
  explainerVideoUrl   String?
  featured            Boolean          @default(false)
  category            String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  brand         Brand            @relation(fields: [brandId], references: [id])
  series        Series?          @relation(fields: [seriesId], references: [id])
  images        FragranceImage[]
  countryStocks FragranceCountryStock[]
  branchStocks  BranchStock[]
  stockTransfers StockTransfer[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  reviews       FragranceReview[]
  barcodes      FragranceBarcode[]

  @@index([brandId])
  @@index([seriesId])
  @@index([slug])
  @@index([condition])
  @@index([price])
  @@index([createdAt])
  @@index([featured])
  @@index([fragranceFamily])
  @@index([concentration])
}

/** Per-country online sellability + country pool qty (hybrid with BranchStock). */
model FragranceCountryStock {
  id          String   @id @default(cuid())
  fragranceId String
  country     String
  inStock     Boolean  @default(true)
  /** Country-level pool used for online availability (sum of branches can sync into this). */
  quantity    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fragrance Fragrance @relation(fields: [fragranceId], references: [id], onDelete: Cascade)

  @@unique([fragranceId, country])
  @@index([country, inStock])
  @@index([fragranceId])
}

/** Scannable barcode per fragrance × bottle size (30 | 50 | 100 ml). */
model FragranceBarcode {
  id          String   @id @default(cuid())
  fragranceId String
  bottleSize  Int
  barcode     String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fragrance Fragrance @relation(fields: [fragranceId], references: [id], onDelete: Cascade)

  @@unique([fragranceId, bottleSize])
  @@index([fragranceId])
  @@index([barcode])
}

/** Physical shop / fulfilment site within a country. */
model Branch {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  country   String
  city      String?
  address   String?
  phone     String?
  active    Boolean  @default(true)
  /** Default fulfilment branch for this country when auto-assigning orders. */
  isDefault Boolean  @default(false)
  /** WhatsApp checkout override (digits). Falls back to StoreConfig country number. */
  whatsappPhone String?
  /** Allow cash-on-delivery for orders fulfilled by this country's default branch. */
  codEnabled    Boolean @default(true)
  /** Offer in-store / branch pickup instead of courier. */
  pickupEnabled Boolean @default(true)
  /** Ghana: offer Dawurobo when credentials exist (default branch drives country checkout). */
  dawuroboEnabled    Boolean @default(true)
  /** Ghana: offer ShaQ Express flat fee. */
  shaqexpressEnabled Boolean @default(true)
  /** Free-text hours, e.g. Mon–Sat 9:00–18:00 */
  openingHours  String?
  /** Staff/customer note (pickup instructions, landmark, etc.) */
  deliveryNotes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks           BranchStock[]
  staffAssignments StaffAssignment[]
  orders           Order[]
  transfersFrom      StockTransfer[]    @relation("TransferFrom")
  transfersTo        StockTransfer[]    @relation("TransferTo")
  attendanceDevices  AttendanceDevice[]
  attendancePunches  AttendancePunch[]
  payRuns            PayRun[]
  journalEntries     JournalEntry[]

  @@index([country])
  @@index([active])
  @@index([country, isDefault])
}

model BranchStock {
  id          String   @id @default(cuid())
  branchId    String
  fragranceId String
  /** Bottle size variation: 30 | 50 | 100 */
  bottleSize  Int      @default(50)
  quantity    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  fragrance Fragrance @relation(fields: [fragranceId], references: [id], onDelete: Cascade)

  @@unique([branchId, fragranceId, bottleSize])
  @@index([fragranceId])
  @@index([branchId])
  @@index([bottleSize])
}

/** Move stock between branches (same country). Large moves may require approval. */
model StockTransfer {
  id            String              @id @default(cuid())
  fromBranchId  String
  toBranchId    String
  fragranceId   String
  bottleSize    Int
  quantity      Int
  reason        String?
  status        StockTransferStatus @default(COMPLETED)
  createdById   String?
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  fromBranch Branch    @relation("TransferFrom", fields: [fromBranchId], references: [id], onDelete: Cascade)
  toBranch   Branch    @relation("TransferTo", fields: [toBranchId], references: [id], onDelete: Cascade)
  fragrance  Fragrance @relation(fields: [fragranceId], references: [id], onDelete: Cascade)
  createdBy  User?     @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?     @relation("TransferApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([fragranceId])
  @@index([createdAt])
  @@index([status])
}

/** Admin activity trail for stock, orders, branches, transfers, catalog, auth. */
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
}

/** One-time token for staff invite / password reset (never email plaintext passwords). */
model AdminPasswordToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  purpose   String   // invite | reset
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/** Staff membership at one or more branches. */
model StaffAssignment {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
}

/** Biometric terminal registered at a branch (ZKTeco, Hikvision, etc.). */
model AttendanceDevice {
  id                String   @id @default(cuid())
  branchId          String
  name              String
  vendor            String?
  serialNumber      String?  @unique
  webhookSecretHash String
  active            Boolean  @default(true)
  lastSyncAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  branch       Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  enrollments  AttendanceEnrollment[]
  punches      AttendancePunch[]

  @@index([branchId])
  @@index([active])
}

/** Maps a staff account to the user ID stored on the biometric device. */
model AttendanceEnrollment {
  id           String   @id @default(cuid())
  userId       String
  deviceId     String
  deviceUserId String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  device AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, deviceUserId])
  @@unique([userId, deviceId])
  @@index([userId])
  @@index([deviceId])
}

/** Clock-in / clock-out event from a device or manual admin entry. */
model AttendancePunch {
  id          String              @id @default(cuid())
  userId      String
  branchId    String
  deviceId    String?
  punchType   AttendancePunchType
  source      AttendanceSource    @default(BIOMETRIC)
  punchedAt   DateTime
  externalId  String?
  note        String?
  createdById String?
  createdAt   DateTime            @default(now())

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  device    AttendanceDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  createdBy User?             @relation("ManualAttendance", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([deviceId, externalId])
  @@index([userId, punchedAt])
  @@index([branchId, punchedAt])
  @@index([punchedAt])
  @@index([deviceId])
}

model FragranceImage {
  id          String   @id @default(cuid())
  fragranceId String
  url         String
  alt         String?
  isPrimary   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  fragrance Fragrance @relation(fields: [fragranceId], references: [id], onDelete: Cascade)

  @@index([fragranceId])
}

model Order {
  id                    String      @id @default(cuid())
  userId                String?
  email                 String
  status                OrderStatus @default(PENDING)
  /** Order value in GHS for reporting, tax, and inventory (book currency). */
  total                 Float
  /** Amount actually charged by the payment provider (may differ from total). */
  chargeAmount          Float?
  /** ISO 4217 code for chargeAmount (e.g. USD, GHS). */
  chargeCurrency        String?
  stripeSessionId       String?     @unique
  stripePaymentId       String?
  shippingMethod        String?
  shippingCost          Float       @default(0)
  shippingName          String?
  shippingPhone         String?
  shippingAddress       String?
  shippingCity          String?
  shippingPostcode      String?
  shippingCountry       String?
  deliveryDate          DateTime?
  deliveryLat           Float?
  deliveryLng           Float?
  shippingRegion        String?
  shippingRegionId      Int?
  deliveryProvider      String?
  dawuroboOrderId       String?     @unique
  dawuroboPayer         String?
  shaqexpressTrackingNumber String? @unique
  paymentProvider       String?
  paystackReference     String?     @unique
  flutterwaveTxRef      String?     @unique
  trackingNumber        String?
  trackingUrl           String?
  carrier               String?
  shippedAt             DateTime?
  confirmationEmailedAt DateTime?
  fulfillmentBranchId   String?
  /** Set when branch stock was deducted for this order. */
  inventoryCommittedAt  DateTime?
  channel               OrderChannel       @default(WEB)
  /** Staff member who completed a POS sale. */
  posUserId             String?
  posPaymentMethod      PosPaymentMethod?
  /** MoMo / card transaction reference for POS sales. */
  posPaymentReference   String?
  /** Human-readable receipt number for walk-in sales. */
  receiptNumber         String?            @unique
  posDiscountType       PosDiscountType?
  /** Percent (0–100) or fixed GHS amount, depending on posDiscountType. */
  posDiscountValue      Float?
  /** Computed discount in GHS applied to this POS sale. */
  posDiscountAmount     Float?
  posNotes              String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  user              User?       @relation(fields: [userId], references: [id])
  posUser           User?       @relation("PosOrders", fields: [posUserId], references: [id], onDelete: SetNull)
  fulfillmentBranch Branch?     @relation(fields: [fulfillmentBranchId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  reviews           FragranceReview[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([paymentProvider])
  @@index([deliveryDate])
  @@index([dawuroboPayer])
  @@index([deliveryProvider])
  @@index([shippingRegion])
  @@index([fulfillmentBranchId])
  @@index([channel])
  @@index([posUserId])
  @@index([receiptNumber])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  fragranceId String
  price       Float
  quantity    Int    @default(1)
  bottleSize  Int    @default(50)
  /** Snapshot unit cost in GHS at time of sale (scaled to bottleSize). */
  unitCostGhs Float?

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fragrance Fragrance @relation(fields: [fragranceId], references: [id])

  @@index([orderId])
  @@index([fragranceId])
}

model FragranceReview {
  id          String   @id @default(cuid())
  fragranceId String
  orderId     String
  userId      String?
  email       String
  authorName  String
  rating      Int
  title       String?
  body        String   @db.Text
  verified    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fragrance Fragrance @relation(fields: [fragranceId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([fragranceId, orderId])
  @@index([fragranceId, createdAt])
  @@index([orderId])
  @@index([userId])
}

model WishlistItem {
  id          String   @id @default(cuid())
  userId      String
  fragranceId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fragrance Fragrance @relation(fields: [fragranceId], references: [id], onDelete: Cascade)

  @@unique([userId, fragranceId])
  @@index([userId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([phone])
}

model AdminNotification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String   @db.Text
  link      String?
  orderId   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([read])
  @@index([createdAt])
  @@index([orderId])
}

model ContactEnquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([read])
  @@index([createdAt])
}

model ShippingMethod {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?  @db.Text
  price           Float
  eta             String
  deliveryDaysMin Int      @default(3)
  deliveryDaysMax Int      @default(10)
  sortOrder       Int      @default(0)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled])
  @@index([sortOrder])
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String    @db.Text
  content     String    @db.Text
  coverImage  String?
  authorName  String    @default("COSY AURA")
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([slug])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum PayFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
}

enum EmployeePaymentMethod {
  BANK
  MOMO
  CASH
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  UNPAID
  COMPASSIONATE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayRunStatus {
  DRAFT
  REVIEW
  APPROVED
  PAID
  CANCELLED
}

/** Extended HR record for admin staff (linked 1:1 to User). */
model EmployeeProfile {
  id                 String                @id @default(cuid())
  userId             String                @unique
  employeeNumber     String?               @unique
  employmentType     EmploymentType        @default(FULL_TIME)
  hireDate           DateTime?
  terminationDate    DateTime?
  jobTitle           String?
  department         String?
  ghanaCardId        String?
  tin                String?
  ssnitNumber        String?
  paymentMethod      EmployeePaymentMethod @default(BANK)
  bankName           String?
  bankAccountNo      String?
  bankBranch         String?
  momoProvider       String?
  momoNumber         String?
  basicSalary        Float                 @default(0)
  housingAllowance   Float                 @default(0)
  transportAllowance Float                 @default(0)
  otherAllowances    Float                 @default(0)
  payFrequency       PayFrequency          @default(MONTHLY)
  notes              String?               @db.Text
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  payRunLines   PayRunLine[]

  @@index([employmentType])
  @@index([hireDate])
}

model LeaveBalance {
  id         String    @id @default(cuid())
  employeeId String
  leaveType  LeaveType
  year       Int
  entitled   Float     @default(0)
  used       Float     @default(0)
  carried    Float     @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  employee EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveType, year])
  @@index([employeeId])
  @@index([year])
}

model LeaveRequest {
  id           String      @id @default(cuid())
  employeeId   String
  leaveType    LeaveType
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  days         Float
  reason       String?     @db.Text
  status       LeaveStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  employee   EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy User?           @relation("LeaveReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
}

model PublicHoliday {
  id        String   @id @default(cuid())
  country   String
  name      String
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([country, date])
  @@index([country])
}

model PayRun {
  id              String       @id @default(cuid())
  branchId        String?
  country         String       @default("GH")
  periodStart     DateTime     @db.Date
  periodEnd       DateTime     @db.Date
  periodLabel     String
  status          PayRunStatus @default(DRAFT)
  currency        String       @default("GHS")
  totalGross      Float        @default(0)
  totalDeductions Float        @default(0)
  totalNet        Float        @default(0)
  totalEmployerSsnit Float     @default(0)
  approvedById    String?
  approvedAt      DateTime?
  paidAt          DateTime?
  notes           String?      @db.Text
  createdById     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  branch     Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy  User         @relation("PayRunCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?        @relation("PayRunApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  lines      PayRunLine[]

  @@unique([country, periodLabel, branchId])
  @@index([periodLabel])
  @@index([status])
  @@index([country])
}

model PayRunLine {
  id                String   @id @default(cuid())
  payRunId          String
  employeeId        String
  userId            String
  basicSalary       Float
  allowances        Float
  overtime          Float    @default(0)
  bonus             Float    @default(0)
  grossPay          Float
  paye              Float    @default(0)
  ssnitEmployee     Float    @default(0)
  ssnitEmployer     Float    @default(0)
  otherDeductions   Float    @default(0)
  totalDeductions   Float
  netPay            Float
  workingDays       Int      @default(0)
  presentDays       Int      @default(0)
  absentDays        Int      @default(0)
  leaveDays         Float    @default(0)
  proRateFactor     Float    @default(1)
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  payRun   PayRun          @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  employee EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payRunId, employeeId])
  @@index([payRunId])
  @@index([employeeId])
  @@index([userId])
}

enum GlAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
}

enum JournalSource {
  MANUAL
  PAYROLL
  EXPENSE
  ORDER
  ORDER_COGS
}

/** Chart of accounts line (Ghana ledger). */
model GlAccount {
  id          String        @id @default(cuid())
  country     String        @default("GH")
  code        String
  name        String
  type        GlAccountType
  description String?       @db.Text
  parentId    String?
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  parent   GlAccount?   @relation("GlAccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children GlAccount[]  @relation("GlAccountHierarchy")
  lines    JournalLine[]

  @@unique([country, code])
  @@index([country])
  @@index([type])
  @@index([active])
}

model JournalEntry {
  id          String             @id @default(cuid())
  country     String             @default("GH")
  entryDate   DateTime           @db.Date
  reference   String
  memo        String?            @db.Text
  status      JournalEntryStatus @default(POSTED)
  source      JournalSource      @default(MANUAL)
  sourceId    String?
  branchId    String?
  createdById String
  postedAt    DateTime           @default(now())
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  branch    Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy User          @relation("JournalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines     JournalLine[]

  @@unique([source, sourceId])
  @@index([country])
  @@index([entryDate])
  @@index([status])
  @@index([branchId])
}

model JournalLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Float    @default(0)
  credit         Float    @default(0)
  memo           String?
  createdAt      DateTime @default(now())

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      GlAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
}

/** Singleton storefront settings (row id = "default"). */
model StoreConfig {
  id                     String   @id @default("default")
  nonAfricaMarkupEnabled Boolean  @default(false)
  nonAfricaMarkupUsd     Float    @default(10)
  /// Master switch for WhatsApp order buttons (checkout + product pages).
  whatsappCheckoutEnabled Boolean @default(false)
  /// ISO country code → WhatsApp number digits, e.g. { "GH": "233500741699", "CM": "2376..." }
  whatsappCheckoutNumbers Json    @default("{}")
  /// When true, storefront redirects to /maintenance (admin stays available).
  maintenanceMode        Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

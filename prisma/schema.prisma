generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Condition {
  UNWORN
  EXCELLENT
  GOOD
}

enum FragranceFamily {
  FLORAL
  ORIENTAL
  WOODY
  FRESH
  CITRUS
  SPICY
}

enum BottleMaterial {
  GLASS
  CRYSTAL
  METAL
  CERAMIC
  ACRYLIC
}

enum CapType {
  MAGNETIC
  SPRAY
  DAB_ON
  SCREW
}

enum Concentration {
  EDT
  EDP
  PARFUM
  EXTRAIT
}

enum Sillage {
  SUBTLE
  MODERATE
  INTENSE
  POWERFUL
}

enum Gender {
  MENS
  WOMENS
  UNISEX
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  phone          String?
  password       String?
  role           Role      @default(USER)
  /** Permanent 5% member discount for email/account signups */
  memberDiscount Boolean   @default(true)
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  orders   Order[]
  wishlist WishlistItem[]

  @@index([email])
  @@index([phone])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fragrances Fragrance[]
  series     Series[]

  @@index([slug])
}

model Series {
  id        String   @id @default(cuid())
  brandId   String
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand      Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  fragrances Fragrance[]

  @@unique([brandId, slug])
  @@index([brandId])
  @@index([slug])
}

model Fragrance {
  id                  String           @id @default(cuid())
  slug                String           @unique
  brandId             String
  seriesId            String?
  model               String
  reference           String
  description         String           @db.Text
  conditionReport     String?          @db.Text
  price               Float
  condition           Condition
  year                Int?
  fragranceFamily     FragranceFamily
  bottleMaterial      BottleMaterial
  bottleDetail        String?
  bottleSize          Int              @default(100)
  capType             CapType
  liquidColor         String?
  longevity           String?
  bottleShape         String?
  concentration       Concentration    @default(EDP)
  topNotes            String[]         @default([])
  heartNotes          String[]         @default([])
  baseNotes           String[]         @default([])
  sillage             Sillage          @default(MODERATE)
  sustainabilityScore Int              @default(3)
  isVegan             Boolean          @default(false)
  isCrueltyFree       Boolean          @default(true)
  sampleAvailable     Boolean          @default(false)
  gender              Gender           @default(UNISEX)
  collection          String?
  stock               Int              @default(0)
  rating              Float?
  featured            Boolean          @default(false)
  category            String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  brand         Brand            @relation(fields: [brandId], references: [id])
  series        Series?          @relation(fields: [seriesId], references: [id])
  images        FragranceImage[]
  countryStocks FragranceCountryStock[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]

  @@index([brandId])
  @@index([seriesId])
  @@index([slug])
  @@index([condition])
  @@index([price])
  @@index([createdAt])
  @@index([featured])
  @@index([fragranceFamily])
  @@index([concentration])
}

/** Per-shop availability (e.g. in stock in GH, out of stock in CM). */
model FragranceCountryStock {
  id          String   @id @default(cuid())
  fragranceId String
  country     String
  inStock     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fragrance Fragrance @relation(fields: [fragranceId], references: [id], onDelete: Cascade)

  @@unique([fragranceId, country])
  @@index([country, inStock])
  @@index([fragranceId])
}

model FragranceImage {
  id          String   @id @default(cuid())
  fragranceId String
  url         String
  alt         String?
  isPrimary   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  fragrance Fragrance @relation(fields: [fragranceId], references: [id], onDelete: Cascade)

  @@index([fragranceId])
}

model Order {
  id                    String      @id @default(cuid())
  userId                String?
  email                 String
  status                OrderStatus @default(PENDING)
  total                 Float
  stripeSessionId       String?     @unique
  stripePaymentId       String?
  shippingMethod        String?
  shippingCost          Float       @default(0)
  shippingName          String?
  shippingPhone         String?
  shippingAddress       String?
  shippingCity          String?
  shippingPostcode      String?
  shippingCountry       String?
  deliveryDate          DateTime?
  deliveryLat           Float?
  deliveryLng           Float?
  shippingRegion        String?
  shippingRegionId      Int?
  deliveryProvider      String?
  dawuroboOrderId       String?     @unique
  dawuroboPayer         String?
  shaqexpressTrackingNumber String? @unique
  paymentProvider       String?
  paystackReference     String?     @unique
  flutterwaveTxRef      String?     @unique
  trackingNumber        String?
  trackingUrl           String?
  carrier               String?
  shippedAt             DateTime?
  confirmationEmailedAt DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  user  User?       @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([paymentProvider])
  @@index([deliveryDate])
  @@index([dawuroboPayer])
  @@index([deliveryProvider])
  @@index([shippingRegion])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  fragranceId String
  price       Float
  quantity    Int    @default(1)

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fragrance Fragrance @relation(fields: [fragranceId], references: [id])

  @@index([orderId])
  @@index([fragranceId])
}

model WishlistItem {
  id          String   @id @default(cuid())
  userId      String
  fragranceId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fragrance Fragrance @relation(fields: [fragranceId], references: [id], onDelete: Cascade)

  @@unique([userId, fragranceId])
  @@index([userId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([phone])
}

model AdminNotification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String   @db.Text
  link      String?
  orderId   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([read])
  @@index([createdAt])
  @@index([orderId])
}

model ContactEnquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([read])
  @@index([createdAt])
}

model ShippingMethod {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?  @db.Text
  price           Float
  eta             String
  deliveryDaysMin Int      @default(3)
  deliveryDaysMax Int      @default(10)
  sortOrder       Int      @default(0)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled])
  @@index([sortOrder])
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String    @db.Text
  content     String    @db.Text
  coverImage  String?
  authorName  String    @default("COSY AURA")
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([slug])
}

/** Singleton storefront settings (row id = "default"). */
model StoreConfig {
  id                     String   @id @default("default")
  nonAfricaMarkupEnabled Boolean  @default(false)
  nonAfricaMarkupUsd     Float    @default(10)
  /// Master switch for WhatsApp order buttons (checkout + product pages).
  whatsappCheckoutEnabled Boolean @default(false)
  /// ISO country code → WhatsApp number digits, e.g. { "GH": "233500741699", "CM": "2376..." }
  whatsappCheckoutNumbers Json    @default("{}")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}
